@model ProyectoIngenieria.Models.ViewModels.RegistroMantenimientoVM
@{
    ViewData["Title"] = "Registrar Mantenimiento";
}

<div class="max-w-4xl mx-auto mt-10 p-6 bg-white rounded-2xl shadow-md border border-gray-200">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">Registrar Mantenimiento</h2>

    <form asp-action="Upsert" method="post">
        <input asp-for="RegistroMantenimiento.Id" type="hidden" />

        <!-- Vehículo -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Vehículo</label>
            <select asp-for="RegistroMantenimiento.VehiculoId" asp-items="Model.ListaVehiculos" class="w-full p-2 border rounded-md"></select>
        </div>

        <!-- Fecha -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Fecha</label>
            <input asp-for="RegistroMantenimiento.Fecha" type="date" class="w-full p-2 border rounded-md" />
        </div>

        <!-- Operario -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Operario</label>
            <div class="flex gap-2">
                <select asp-for="RegistroMantenimiento.OperadorCedula" asp-items="Model.ListaOperadores" class="flex-1 p-2 border rounded-md"></select>
                <a asp-controller="Operador" asp-action="Upsert" class="bg-blue-500 text-white px-3 py-2 rounded hover:bg-blue-600">+ Nuevo</a>
            </div>
        </div>

        <!-- Catálogo mantenimiento -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Mantenimiento realizado</label>
            <select asp-for="RegistroMantenimiento.CatalogoMantenimientoId" asp-items="Model.ListaCatalogoMantenimiento" class="w-full p-2 border rounded-md"></select>
        </div>

        <!-- Descripción adicional -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Descripción (opcional)</label>
            <textarea asp-for="RegistroMantenimiento.Descripcion" class="w-full p-2 border rounded-md"></textarea>
        </div>

        <!-- Precio -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Precio</label>
            <input asp-for="RegistroMantenimiento.Precio" type="number" step="0.01" class="w-full p-2 border rounded-md" />
        </div>

        <!-- Repuestos -->
        <div class="mb-4">
            <label class="block font-semibold mb-1">Repuestos utilizados</label>
            <select asp-for="RegistroMantenimiento.RepuestoId" asp-items="Model.ListaRepuestos" multiple class="w-full p-2 border rounded-md h-32"></select>
            <small class="text-gray-500">Mantén presionada Ctrl (Cmd en Mac) para seleccionar múltiples.</small>
        </div>

        <div class="mt-6 flex justify-between">
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded">Guardar y continuar</button>
            <a asp-action="Index" class="text-blue-600 hover:underline">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
