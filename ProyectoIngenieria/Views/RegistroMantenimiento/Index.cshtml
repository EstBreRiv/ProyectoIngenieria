@{
    ViewData["Title"] = "Historial de Mantenimientos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css" />
</head>
<body class="bg-light py-4">

    <input type="hidden" id="VehiculoIdHidden" value="@ViewBag.VehiculoId" />


    <div class="container bg-white p-4 rounded shadow">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
            <h1 class="h3 mb-0">Historial de Mantenimientos</h1>

            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="RegistroMantenimiento" asp-action="Upsert" class="btn btn-success">
                    Registrar nuevo mantenimiento
                </a>
                <a asp-controller="Repuesto" asp-action="Index" class="btn btn-success">
                    Ver repuestos
                </a>
                <a asp-controller="CatalogoMantenimiento" asp-action="Index" class="btn btn-primary">
                    Ver catálogo de mantenimientos
                </a>
            </div>
        </div>

        <div class="table-responsive">

@*             filtro por fecha
 *@
            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="filtroInicio" class="form-label">Fecha desde</label>
                    <input type="text" id="filtroInicio" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label for="filtroFin" class="form-label">Fecha hasta</label>
                    <input type="text" id="filtroFin" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button id="btnFiltrar" class="btn btn-primary w-100">Filtrar</button>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button id="btnLimpiar" class="btn btn-outline-secondary w-100">Limpiar filtros</button>
                </div>
            </div>

            <table id="tablaMantenimiento" class="table table-bordered table-striped table-hover align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th>Vehículo</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                        <th>Precio</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Datos se cargan por JavaScript -->
                </tbody>
            </table>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- JS personalizado -->
    <script src="~/js/RegistroMantenimiento.js"></script>

    @section Scripts {
        <!-- Flatpickr -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

        <script>
            flatpickr("#filtroInicio", {
                locale: "es",
                dateFormat: "Y-m-d",
            });

            flatpickr("#filtroFin", {
                locale: "es",
                dateFormat: "Y-m-d",
            });
        </script>
    }

</body>
</html>
