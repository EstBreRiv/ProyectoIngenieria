@using ProyectoIngenieria.Models.ViewModels
@model ProyectoVM


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 bg-white p-4 rounded shadow-sm">
            <form method="post">
                <input hidden asp-for="Proyecto.Id" />


                <!-- Header -->
                <div class="border-bottom pb-3 mb-4">
                    <h2 class="h4 text-success">
                        @(Model.Proyecto.Id == 0 ? "Agregar" : "Actualizar") Proyecto
                    </h2>
                </div>

                <!-- Nombre -->
                <div class="mb-3">
                    <label asp-for="Proyecto.NombreProyecto" class="form-label text-muted"></label>
                    <input asp-for="Proyecto.NombreProyecto" type="text" class="form-control" placeholder="Ingrese el nombre del proyecto" />
                    <span asp-validation-for="Proyecto.NombreProyecto" class="form-text text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Proyecto.Cliente" class="form-label text-muted"></label>
                    <input asp-for="Proyecto.Cliente" type="text" class="form-control" placeholder="Ingrese el nombre del cliente" />
                    <span asp-validation-for="Proyecto.Cliente" class="form-text text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Proyecto.FechaInicio" class="form-label text-muted">Indique la fecha de Inicio del Proyecto</label>
                    <input asp-for="Proyecto.FechaInicio" type="text" class="form-control" id="fechaInicio" />
                    <span asp-validation-for="Proyecto.FechaInicio" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Proyecto.FechaFin" class="form-label text-muted">Indique la fecha de cierre del Proyecto</label>
                    <input asp-for="Proyecto.FechaFin" type="text" class="form-control" id="fechaFin" />
                    <span asp-validation-for="Proyecto.FechaFin" class="text-danger small"></span>
                </div>

                <!-- Botones -->

                <div class="d-flex gap-3 pt-3">
                    <button type="submit" class="btn btn-success w-50">
                        Guardar
                    </button>
                    <a asp-controller="Proyecto" asp-action="Index" class="btn btn-outline-secondary w-50 text-center">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- Flatpickr -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

    <script>
        flatpickr("#fechaInicio", {
            locale: "es",
            dateFormat: "Y-m-d", // <-- esto envía yyyy-MM-dd
            defaultDate: "today"
        });

        flatpickr("#fechaFin", {
            locale: "es",
            dateFormat: "Y-m-d", // <-- formato compatible con DateTime en .NET
            defaultDate: "today"
        });

    </script>

}

