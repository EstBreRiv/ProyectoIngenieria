@using ProyectoIngenieria.Models.ViewModels
@model DocumentoOperadorVM

<form method="post" enctype="multipart/form-data">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 bg-white p-4 rounded shadow-sm">
            <form method="post">

                <!-- Header -->
                <div class="border-bottom pb-3 mb-4">
                    <h2 class="h4 text-success">
                        Cargar Documento de Operador
                    </h2>
                </div>

                <!-- Nombre -->
                <div class="mb-3">
                    <label asp-for="DocumentoOperador.Nombre" class="form-label text-muted"></label>
                    <input asp-for="DocumentoOperador.Nombre" type="text" class="form-control" placeholder="Ingrese el título del documento" />
                    <span asp-validation-for="DocumentoOperador.Nombre" class="form-text text-danger"></span>
                </div>

                <!-- Archivo -->
                <div class="mb-3">
                    <label class="form-label text-muted">Seleccionar archivo</label>
                    <input type="file" name="Archivo" class="form-control" />
                </div>

                <!-- Botones -->
                <div class="d-flex gap-3 pt-3">
                    <button type="submit" class="btn btn-success w-50">
                        Guardar
                    </button>
                    <a asp-controller="Operador" asp-action="Index" class="btn btn-outline-secondary w-50 text-center">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
