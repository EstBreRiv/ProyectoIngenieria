@using ProyectoIngenieria.Models.ViewModels
@model OperadorVM

@{
    ViewData["Title"] = "Documentos del Operador";
}
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

<body class="bg-light p-4">

    <div class="container mt-4">
        <h2>Documentos del operador: @Model.Operador.Nombre (@Model.Operador.Cedula)</h2>

        <p class="text-muted">Aquí podrás ver, agregar o eliminar documentos relacionados con este operador.</p>

        <!-- Aquí agregarás más contenido en el futuro -->

    </div>

    <div class="container bg-white p-4 rounded shadow">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-controller="Operador" asp-action="CargarDocumentoOperador" class="btn btn-success">
                Cargar Documento
            </a>
        </div>

        <div class="table-responsive">
            <table id="taskTable" class="table table-bordered table-hover">
                <thead class="table-success text-dark">
                    <tr>
                        <th>Título</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Los datos se cargan vía JavaScript (AJAX o fetch) -->
                </tbody>
            </table>
        </div>
        <a asp-controller="Operador" asp-action="Index" class="btn btn-outline-secondary w-50 text-center">
            Volver
        </a>
    </div>

    <!-- JS de jQuery y Bootstrap y DataTables -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- Tu JS personalizado -->
    <script src="/js/DocumentoOperador.js"></script>
</body>




