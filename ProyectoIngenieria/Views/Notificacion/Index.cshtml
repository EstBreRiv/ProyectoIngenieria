@{
    ViewData["Title"] = "Buzón de Notificaciones";
}

<div class="container bg-white p-4 rounded shadow">
    <h1 class="h3 text-success mb-4">Buzón de Notificaciones</h1>

    <div class="table-responsive">
        <table id="notificacionesTable" class="table table-bordered table-hover">
            <thead class="table-success text-dark">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Placa</th>
                    <th>Vehículo</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- Tu script JS personalizado para notificaciones -->
    <script src="~/js/Notificacion.js"></script>

    <!-- Script para marcar como leídas una vez cargadas -->
    <script>
        // Este evento se dispara una vez que DataTables carga los datos por AJAX
        $('#notificacionesTable').on('xhr.dt', function () {
            fetch("/Notificacion/MarcarTodasComoLeidas", {
                method: "POST"
            }).then(() => {
                console.log("Notificaciones marcadas como leídas");
            });
        });
    </script>
}