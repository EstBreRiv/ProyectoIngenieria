@model ProyectoIngenieria.Models.CatalogoMantenimiento

<div class="max-w-2xl mx-auto mt-12 bg-white p-10 rounded-3xl shadow-lg border border-gray-300">
    <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">
        @(Model.Id == 0 ? "Nuevo Mantenimiento" : "Editar Mantenimiento")
    </h2>

    <form asp-action="Upsert" method="post" class="space-y-6">
        <input type="hidden" asp-for="Id" />

        <div>
            <label asp-for="Nombre" class="block text-gray-700 font-medium mb-2">Nombre del mantenimiento</label>
            <input asp-for="Nombre"
                   class="w-full px-4 py-2 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 transition" />
            <span asp-validation-for="Nombre" class="text-sm text-red-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Descripcion" class="block text-gray-700 font-medium mb-2">Descripción</label>
            <textarea asp-for="Descripcion" rows="4"
                      class="w-full px-4 py-2 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500 transition"></textarea>
            <span asp-validation-for="Descripcion" class="text-sm text-red-500 mt-1 block"></span>
        </div>

        <div class="flex justify-center gap-4 pt-4">
            <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-xl transition shadow">
                Guardar
            </button>
            <a asp-action="Index"
               class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold px-6 py-2 rounded-xl transition shadow border">
                Cancelar
            </a>
        </div>
    </form>
</div>
