<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RegistroCombustible</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <style>
        .dt-search-0 {
            color: black;
        }
    </style>
</head>
<body class="bg-light p-4">

    <input type="hidden" id="VehiculoIdHidden" value="@ViewBag.VehiculoId" /> 

    <div class="container bg-white p-4 rounded shadow">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 text-success fw-bold">Registros de combustible</h1>

            <a href="/RegistroCombustible/Upsert?vehiculoId=@ViewBag.VehiculoId" class="btn btn-success">
                Agregar registro
            </a>
        </div>

        <div class="row mb-3">
            <div class="col-md-3">
                <label for="fechaInicio">Fecha inicio</label>
                <input type="date" id="fechaInicio" class="form-control">
            </div>
            <div class="col-md-3">
                <label for="fechaFin">Fecha fin</label>
                <input type="date" id="fechaFin" class="form-control">
            </div>
            <div class="col-md-3 align-self-end">
                <button id="btnFiltrar" class="btn btn-primary">Filtrar</button>
                <button id="btnLimpiar" class="btn btn-secondary">Limpiar</button>
            </div>
        </div>

        <div class="table-responsive">
            <table id="taskTable" class="table table-bordered table-hover">
                <thead class="table-success text-dark">
                    <tr>
                        <th>Numero de registro</th>
                        <th>Fecha de compra</th>
                        <th>Litros comprados</th>
                        <th>Precio por litro</th>
                        <th>Total pagado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>

                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-start mt-4">
        <a href="/Vehiculo/DetalleVehiculo/@ViewBag.VehiculoId" class="btn btn-success">
            ← Volver a detalles del vehículo
        </a>

    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>
    

    <script src="/js/RegistroCombustible.js"></script>
</body>
</html>

