<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vehículos</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- DataTables CSS (Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.bootstrap5.css" />
</head>
<body class="bg-success py-5">

    <div class="container bg-white p-4 rounded shadow">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 fw-bold text-dark">Tipos de vehiculos</h1>
            <a asp-controller="TipoVehiculo" asp-action="Upsert" class="btn btn-success">
                Agregar Categoria
            </a>
        </div>

        <div class="table-responsive">
            <table id="taskTable" class="table table-bordered table-hover table-sm align-middle text-center">
                <thead class="table-success text-dark">
                    <tr>
                        <th>Tipo de vehiculo</th>
                        <th>Descripcion</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                  
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-end mt-3">
            <a asp-controller="TipoVehiculo" asp-action="Index" class="btn btn-outline-secondary w-auto">
                Volver
            </a>
        </div>
    </div>


    <!-- jQuery y DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>
    

    <script src="/js/TipoVehiculo.js"></script>
</body>
</html>
