@model ProyectoIngenieria.Models.Repuesto
@{
    ViewData["Title"] = "Repuesto";
}

<div class="max-w-2xl mx-auto mt-10 p-6 bg-white rounded-xl shadow-md border border-gray-200">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">
        @(Model.Id == 0 ? "Agregar nuevo repuesto" : "Editar repuesto")
    </h2>

    <form asp-action="Upsert" method="post">
        <input asp-for="Id" type="hidden" />

        <div class="mb-4">
            <label asp-for="Nombre" class="block font-semibold mb-1">Nombre</label>
            <input asp-for="Nombre" class="w-full p-2 border rounded-md" />
            <span asp-validation-for="Nombre" class="text-red-500 text-sm"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Descripcion" class="block font-semibold mb-1">Descripción</label>
            <textarea asp-for="Descripcion" class="w-full p-2 border rounded-md"></textarea>
            <span asp-validation-for="Descripcion" class="text-red-500 text-sm"></span>
        </div>

        <div class="mb-4">
            <label asp-for="PrecioEstimado" class="block font-semibold mb-1">Precio Estimado</label>
            <input asp-for="PrecioEstimado" type="number" step="0.01" class="w-full p-2 border rounded-md" />
            <span asp-validation-for="PrecioEstimado" class="text-red-500 text-sm"></span>
        </div>

        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md">Guardar</button>
        <a asp-action="Index" class="ml-3 text-blue-600 hover:underline">Volver</a>
    </form>
</div>
