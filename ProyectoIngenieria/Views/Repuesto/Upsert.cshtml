@model ProyectoIngenieria.Models.CatalogoRepuesto
@{
    ViewData["Title"] = "Repuesto";
}

<div class="container mt-5">
    <div class="card shadow border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="card-title h4 mb-4">
                @(Model.Id == 0 ? "Agregar nuevo repuesto" : "Editar repuesto")
            </h2>

            <form asp-action="Upsert" method="post">
                <input asp-for="Id" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioEstimado" class="form-label fw-semibold">Precio Estimado</label>
                    <input asp-for="PrecioEstimado" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="PrecioEstimado" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <a asp-action="Index" class="btn btn-link text-decoration-none">Volver</a>
                </div>
            </form>
        </div>
    </div>
</div>
