@model ProyectoIngenieria.Models.ViewModels.VehiculoVM

@{
    ViewData["Title"] = "Detalles del Vehículo";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Detalles del Vehículo</h4>


        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Modelo</dt>
                <dd class="col-sm-9">@Model.Vehiculo.Modelo</dd>

                <dt class="col-sm-3">Estado</dt>
                <dd class="col-sm-9">@Model.Vehiculo.Estado</dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Vehiculo.Descripcion) ? Model.Vehiculo.Descripcion : "-")</dd>

                <dt class="col-sm-3">Placa</dt>
                <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Vehiculo.Placa) ? Model.Vehiculo.Placa : "-")</dd>

                <dt class="col-sm-3">Tipo</dt>
@*                 <dd class="col-sm-9">@Model.Vehiculo.Tipo</dd>
 *@
                <dt class="col-sm-3">Empresa</dt>
                <dd class="col-sm-9">@Model.Vehiculo.Empresa?.Nombre</dd>
            </dl>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <a asp-controller="Vehiculo" asp-action="Upsert" asp-route-id="@Model.Vehiculo.Id" class="btn btn-warning">
                    <i class="bi bi-pencil-square"></i> Editar
                </a>

                @if (Model.Vehiculo.Estado == "Activo")
                {
                    <button class="btn btn-danger" onclick="Delete(@Model.Vehiculo.Id)">
                        <i class="bi bi-trash"></i> Desactivar
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" onclick="Activar(@Model.Vehiculo.Id)">
                        <i class="bi bi-check-circle"></i> Activar
                    </button>
                }


                <a href="/RegistroCombustible/Index/@Model.Vehiculo.Id" class="btn btn-success">
                    Registro Combustible
                </a>

                <a href="/RegistroMantenimiento/Index/@Model.Vehiculo.Id" class="btn btn-success">
                    Mantenimientos
                </a>

                <a href="/HorasTrabajo/Index/@Model.Vehiculo.Id" class="btn btn-success">
                    Horas de Trabajo
                </a>

                <a href="/Vehiculo/DocumentoVehiculo/@Model.Vehiculo.Id" class="btn btn-success">
                    Documentos
                </a>

                <a href="/Vehiculo/Index" class="btn btn-outline-secondary ms-auto">
                    Volver a la lista
                </a>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="~/js/vehiculo-detalle.js"></script>
}
