@using ProyectoIngenieria.Models.ViewModels
@model VehiculoVM

@{
    ViewData["Title"] = Model.Vehiculo.Id == 0 ? "Crear Vehículo" : "Editar Vehículo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-center mb-4">@ViewData["Title"]</h2>

            <form method="post" asp-action="Upsert">
                <input type="hidden" asp-for="Vehiculo.Id" />
                <input type="hidden" asp-for="Vehiculo.Estado" />


                <div class="card shadow border">
                    <div class="card-body">
                        <!-- Modelo -->
                        <div class="mb-3">
                            <label asp-for="Vehiculo.Modelo" class="form-label"></label>
                            <input asp-for="Vehiculo.Modelo" class="form-control" placeholder="Ingrese el modelo del vehículo" />
                            <span asp-validation-for="Vehiculo.Modelo" class="text-danger small"></span>
                        </div>

                        <!-- Tipo -->
                        <div class="mb-3">
                            <label asp-for="Vehiculo.Tipo" class="form-label"></label>
                            <select asp-for="Vehiculo.Tipo" class="form-select">
                                <option value="">Seleccione Tipo</option>
                                <option value="Maquinaria">Maquinaria</option>
                                <option value="Vehículo">Vehículo</option>
                            </select>
                            <span asp-validation-for="Vehiculo.Tipo" class="text-danger small"></span>

                        </div>

                        <!-- Descripción -->
                        <div class="mb-3">
                            <label asp-for="Vehiculo.Descripcion" class="form-label"></label>
                            <textarea asp-for="Vehiculo.Descripcion" rows="3" class="form-control" placeholder="Descripción del vehículo: Color, Característica"></textarea>
                            <span asp-validation-for="Vehiculo.Descripcion" class="text-danger small"></span>

                        </div>

                        <!-- Checkbox Placa -->
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="mostrarPlacaCheck" name="mostrarPlaca"
                            @(string.IsNullOrEmpty(Model.Vehiculo.Placa) ? "" : "checked") />

                            <label class="form-check-label" for="mostrarPlacaCheck">¿Tiene placa?</label>
                        </div>

                        <!-- Placa (condicional) -->
                        <div id="placaContainer" class="mb-3 @(string.IsNullOrEmpty(Model.Vehiculo.Placa) ? "d-none" : "")">
                            <label asp-for="Vehiculo.Placa" class="form-label"></label>
                            <input asp-for="Vehiculo.Placa" class="form-control" placeholder="Número de placa del vehículo" />
                            <span asp-validation-for="Vehiculo.Placa" class="text-danger small"></span>

                        </div>

                        <!-- Empresa -->
                        <div class="mb-4">
                            <label asp-for="Vehiculo.EmpresaId" class="form-label">Seleccione la empresa asociada</label>
                            <select asp-for="Vehiculo.EmpresaId" asp-items="@ViewBag.EmpresaList" class="form-select">
                                <option value="">Seleccione Empresa</option>
                            </select>
                            <span asp-validation-for="Vehiculo.EmpresaId" class="text-danger small"></span>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex justify-content-end gap-2 pt-3">
                            <button type="submit" class="btn btn-success w-25">
                                @(Model.Vehiculo.Id == 0 ? "Crear" : "Actualizar")

                            </button>
                            <a asp-controller="Vehiculo" asp-action="DetalleVehiculo" asp-route-id="@Model.Vehiculo.Id" class="btn btn-outline-secondary w-25">
                                Volver
                            </a>

                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('#mostrarPlacaCheck').change(function () {
                if (this.checked) {
                    $('#placaContainer').removeClass('d-none').hide().slideDown();
                } else {
                    $('#placaContainer').slideUp(function () {
                        $(this).addClass('d-none');
                        $('#Vehiculo_Placa').val('');
                    });
                }
            });
        });
    </script>
}
