@using ProyectoIngenieria.Models.ViewModels
@model DocumentoVehiculoVM

<form method="post" enctype="multipart/form-data">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6 bg-white p-4 rounded shadow-sm">
                <div class="border-bottom pb-3 mb-4">
                    <h2 class="h4 text-success">
                        Cargar Documento del Vehículo
                    </h2>
                </div>

                <div class="mb-3">
                    <label asp-for="DocumentoVehiculo.Nombre" class="form-label text-muted"></label>
                    <input asp-for="DocumentoVehiculo.Nombre" type="text" class="form-control" placeholder="Ingrese el título del documento" />
                    <span asp-validation-for="DocumentoVehiculo.Nombre" class="form-text text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted">Seleccionar archivo</label>
                    <input type="file" name="Archivo" class="form-control" />
                </div>
                <input type="hidden" asp-for="DocumentoVehiculo.VehiculoId" />

                <div class="d-flex gap-3 pt-3">
                    <button type="submit" class="btn btn-success w-50">
                        Guardar
                    </button>
                    <a asp-controller="Vehiculo" asp-action="Index" class="btn btn-outline-secondary w-50 text-center">
                        Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
