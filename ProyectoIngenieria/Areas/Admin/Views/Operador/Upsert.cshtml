@using ProyectoIngenieria.Models.ViewModels
@model OperadorVM

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 bg-white p-4 rounded shadow-sm">
            <form method="post">

                <div class="border-bottom pb-3 mb-4">
                    <h2 class="h4 text-success">
                        @(Model.Operador.Cedula == 0 ? "Agregar" : "Actualizar") Operador
                    </h2>
                </div>

                @if (Model.Operador.Cedula == 0)
                {
                    <div class="mb-3">
                        <label asp-for="Operador.Cedula" class="form-label text-muted"></label>
                        <input asp-for="Operador.Cedula" type="number" class="form-control" placeholder="Ingrese la cédula del operador" />
                        <span asp-validation-for="Operador.Cedula" class="form-text text-danger"></span>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Operador.Cedula" />
                }

                <div class="mb-3">
                    <label asp-for="Operador.Nombre" class="form-label text-muted"></label>
                    <input asp-for="Operador.Nombre" type="text" class="form-control" placeholder="Ingrese el nombre del operador" />
                    <span asp-validation-for="Operador.Nombre" class="form-text text-danger"></span>
                </div>

                 <div class="mb-4">
                    <label asp-for="VehiculoId" class="form-label">Seleccione el vehículo que opera</label>
                    <select asp-for="VehiculoId" asp-items="@ViewBag.VehiculosList" class="form-select">
                        <option value="">Seleccione Vehículo</option>
                    </select>
                    <span asp-validation-for="VehiculoId" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-3 pt-3">
                    <button type="submit" class="btn btn-success w-50">
                        Guardar
                    </button>
                    <a asp-controller="Operador" asp-action="Index" class="btn btn-outline-secondary w-50 text-center">
                        Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
