@model ProyectoIngenieria.Models.CatalogoMantenimiento

<div class="container mt-5">
    <div class="card shadow border-0 mx-auto" style="max-width: 600px;">
        <div class="card-body">
            <h2 class="card-title text-center h4 mb-4">
                @(Model.Id == 0 ? "Nuevo Mantenimiento" : "Editar Mantenimiento")
            </h2>

            <form asp-action="Upsert" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-semibold">Nombre del mantenimiento</label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-semibold">Descripción</label>
                    <textarea asp-for="Descripcion" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-center gap-3 pt-3">
                    <button type="submit" class="btn btn-primary px-4">
                        Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
