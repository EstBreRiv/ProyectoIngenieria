@{
    ViewData["Title"] = "Repuestos";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4">Gestión de Repuestos</h1>
        <a asp-controller="Repuesto" asp-action="Upsert" class="btn btn-primary">
            + Nuevo Repuesto
        </a>
    </div>

    <div class="table-responsive border rounded">
        <table id="tablaRepuesto" class="table table-striped table-bordered">
            <thead class="table-light text-center">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio Estimado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- Cargado dinámicamente con JS -->
            </tbody>
        </table>
    </div>
</div>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
<script src="https://cdn.datatables.net/2.0.7/js/dataTables.bootstrap5.min.js"></script>

<script src="~/js/Repuesto.js"></script>
